#!/bin/sh
#
# Runs the linters and test suite before every commit and blocks the commit if any of them fail.
# Enable with: git config core.hooksPath .githooks
# Skip once with: git commit --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v hugo >/dev/null 2>&1; then
  echo "pre-commit: hugo is not installed; cannot run tests." >&2
  exit 1
fi

if ! command -v ruff >/dev/null 2>&1; then
  echo "pre-commit: ruff is not installed; run \`brew install ruff\` first." >&2
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "pre-commit: lint tools are not installed; run \`npm install\` first." >&2
  exit 1
fi

echo "pre-commit: linting..."
if ! npm run --silent lint; then
  echo "pre-commit: lint failed; commit aborted. Run \`npm run format\` to auto-fix what it can. (Use --no-verify to skip.)" >&2
  exit 1
fi

echo "pre-commit: running tests..."
if ! python3 -m unittest discover -s tests; then
  echo "pre-commit: tests failed; commit aborted. (Use --no-verify to skip.)" >&2
  exit 1
fi
